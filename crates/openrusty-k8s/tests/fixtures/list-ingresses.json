{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "IngressList",
  "metadata": {
    "resourceVersion": "100",
    "selfLink": "/apis/networking.k8s.io/v1/ingresses"
  },
  "items": [
    { "metadata": { "name": "app", "namespace": "web", "resourceVersion": "101" },
      "spec": {
        "ingressClassName": "openrusty",
        "rules": [
          { "host": "App.Example.COM", "http": { "paths": [
            { "path": "/v1/chat", "pathType": "Exact",
              "backend": { "service": { "name": "example-svc", "port": { "number": 8000 } } } },
            { "path": "/", "pathType": "Prefix",
              "backend": { "service": { "name": "example-svc", "port": { "number": 8000 } } } }
          ] } }
        ]
      } },
    { "metadata": { "name": "added", "namespace": "web", "resourceVersion": "102" },
      "spec": {
        "ingressClassName": "openrusty",
        "rules": [
          { "host": "second.example.com", "http": { "paths": [
            { "path": "/", "pathType": "Prefix",
              "backend": { "service": { "name": "second-svc", "port": { "number": 8100 } } } }
          ] } }
        ]
      } }
  ],
  "aFieldTheGatewayDoesNotKnow": [1, 2, 3]
}
